// Laser DXF settings. Keep this file next to LaserDxf.cs (same folder).
// Lines starting with // are comments. Paths: use / or \\ (a single \ before a
// letter also works, but never end a path with a single \).
{
  "outputFolder": "C:/Laser DXF",
  // Placeholders: {ID} {REV} {REVRAW} {NAME} {MATERIAL} {THK}. An empty placeholder
  // also drops the separator before it, so "{ID}-{REV}" without a revision gives "{ID}".
  "fileNameFormat": "{ID}-{REV}.dxf",
  "askBeforeOverwrite": true,
  "showOptionsDialog": true,          // options dialog before each export (orientation, etch position, text mode, DXF version, folder)
  "showPreview": true,                // preview window: drag/rotate/edit the text before the DXF is written

  "geometry": {
    "tolerance": 0.01,                // mm, matching/flatness tolerance
    "chordTolerance": 0.02,           // mm, max deviation when splines are written as polylines
    "xAlign": "LongestEdge"           // "LongestEdge" or "WCS"
  },

  "dxf": {
    "version": "R2000",               // "R2000" (recommended) or "R12" (oldest CAM software)
    "textMode": "Stroke",             // step 4/5: "Stroke" = single-line vectors, "Text" = DXF TEXT
    "cutLayer":  { "name": "CUT",  "color": 7 },
    "etchLayer": { "name": "ETCH", "color": 5 },
    "entityColors": true              // also colour each entity (not just ByLayer)
  },

  "labels": {                         // steps 3-4
    "textHeight": 3,
    "gap": 1.5,                       // label distance from the hole edge, mm
    "holeClearance": 1.0,
    "edgeClearance": 2.0,
    "useHoleFeatures": true,          // read thread size / countersink from NX Hole features first
    "threadLabelFormat": "{THREAD}",  // "M8 x 1.25" -> {THREAD} = "M8"
    "countersinkLabel": "CS",
    "countersinkDescription": "countersunk hole - countersink after cutting",
    "table": [
      // label, modelled diameter (mm), +/- tolerance, optional laser cut diameter (null = as modelled)
      // "description" is printed in the hole key on the PDF sheet.
      { "label": "R6", "diameter": 5.8, "tolerance": 0.05, "cutDiameter": null, "description": "6 mm reamed dowel hole - ream after cutting" },
      { "label": "M8", "diameter": 5.5, "tolerance": 0.05, "cutDiameter": null, "description": "M8 tapped hole - drill and tap after cutting" }
    ]
  },

  "etch": {                           // step 5
    "format": "{ID}-{REV}",           // e.g. S180-06068-47005-1. {REVRAW} is always the number.
    "revisionAsLetter": false,        // true: 1 -> A, 2 -> B ... 27 -> AA
    "textHeight": 5,
    "minTextHeight": 3,
    "clearance": 3,
    "placement": "Auto",              // "Auto" (largest clear area) or "Pick" (click on the plate)
    "allowRotate90": true
  },

  // Teamcenter attributes, by the names NX Open reports (not the dialog's display names):
  // title (or alias) + category. If an ID or revision isn't found, the listing window prints
  // every attribute with its real category and title.
  "attributes": {
    "id":         { "title": "DB_PART_NO",     "category": "ONE4_MCAD" },          // dialog: MCAD / ID
    "revision":   { "title": "DB_PART_REV",    "category": "ONE4_MCADRevision" },  // dialog: MCAD Revision / Revision
    "fallbackId": { "title": "Part_Number",    "category": "Lentus Attributes", "ignoreValues": ["model-plain-1"] },
    "name":       { "title": "DB_PART_NAME",   "category": "ONE4_MCAD" },
    "material":   { "title": "Polar_Material", "category": "ONE4_MCADRevision" },
    "thickness":  { "title": "Matl_Thk",       "category": "Materials" },
    "drawnBy":    { "title": "DRAWN_BY",       "category": "person" },
    "revisionFromPartName": true      // no revision attribute? use the "/1" of a part name like S180-06068-47020/1
  },

  // PDF instruction sheet written next to each DXF, to send to the laser shop.
  // The DXF as a PDF at 1:1 (the "Export DXF + PDF" button in the preview), for laser shops that
  // can't open the DXF. Same geometry, cut black, etch blue, PDF layers CUT / ETCH, nothing else on the page.
  "cutPdf": {
    "default": false,                 // true = write it even without the preview, and make it the preview's default button
    "fileNameFormat": "{ID}-{REV}.pdf",
    "lineWidth": 0.1,                 // mm
    "margin": 10,                     // mm of blank page around the plate
    "layers": true                    // PDF layers named like the DXF layers
  },
  // PDF instruction sheet (single plate journal only)
  "pdf": {
    "enabled": true,
    "fileNameFormat": "{ID}-{REV} instruction.pdf",
    "sheet": "Auto",                  // "Auto" (A4, or A3 when it shows the plate larger), "A4" or "A3"
    "company": "",                    // shown in the title block
    "title": "LASER CUTTING INSTRUCTION",
    "minTextHeight": 1.8,             // mm on paper: small etch text is enlarged on the sheet so it stays readable
    // Notes, numbered in order. A leading "!" prints the note in bold red.
    // Placeholders: {DXF} {ETCH} {ID} {REV} {NAME} {MATERIAL} {THK} {DRAWNBY}
    "notes": [
      "Cut the profile and all holes from the DXF file {DXF} (layer CUT).",
      "!ETCH ALL TEXT ON LAYER ETCH (shown blue on this sheet): the part number {ETCH} and every hole label. Do not omit any etching.",
      "Etch on the face shown - this view is from the etch side.",
      "Material: {MATERIAL} {THK} mm thick.",
      "Remove all burrs and sharp edges."
    ]
  },

  "batch": {                          // LaserDxfBatch.cs
    // DXFs and the CSV go in a folder named after the assembly (the displayed part), e.g.
    // <outputFolder>\S180-06068-37003-1\S180-06068-37003-1.csv. "" = straight into outputFolder.
    "folderFormat": "{ID}-{REV}",
    "csvFileName": "{ID}-{REV}.csv",  // re-running the batch updates the rows of the plates exported again
    // Qty = occurrences of the plate in the assembly (as in the Assembly Navigator), per jig.
    // Suppressed components, and components with one of these attributes set, aren't counted.
    "qtyExcludeAttributes": ["REFERENCE_COMPONENT", "PLIST_IGNORE_MEMBER"],
    "allowedThicknesses": [6, 3],     // mm (Matl_Thk); other plates are skipped. [] = any thickness
    "thicknessTolerance": 0.1,
    "writeCsv": true,
    // CSV columns: header + value. Placeholders: {ID} {REV} {REVRAW} {NAME} {QTY} {MATERIAL}
    // {THICKNESS} (e.g. 6mm: Matl_Thk, or the measured thickness if it's missing) {DXF} (full path) {DXFNAME}.
    // Rows are grouped by thickness (thickest first), then sorted by part number.
    "csvColumns": [
      { "header": "ID",        "value": "{ID}-{REV}" },
      { "header": "Revision",  "value": "{REVRAW}" },
      { "header": "Name",      "value": "{NAME}" },
      { "header": "Qty",       "value": "{QTY}" },
      { "header": "Material",  "value": "{MATERIAL}" },
      { "header": "Thickness", "value": "{THICKNESS}" },
      { "header": "DXF path",  "value": "{DXF}" }
    ]
  },

  // Jig part request list: an Excel workbook written next to the batch CSV, made from your own
  // template (logos, borders and print setup are kept). The template goes in the same folder as
  // this config file (or give a full path). Columns map a sheet column to a CSV column header.
  "requestList": {
    "enabled": true,
    "template": "Jig Part Request List.xlsx",
    "fileName": "{ID}-{REV}.xlsx",    // named after the assembly, like the CSV
    "sheet": "",                      // sheet to fill; "" = the first sheet
    "firstRow": 4,                    // first empty row under the headers
    "columns": { "A": "ID", "B": "Material", "C": "Thickness", "D": "Qty" },
    "titleCell": "A2",                // the assembly number goes here (top-left cell if merged); "" = none
    "title": "{ID}-{REV}",            // e.g. S180-06068-37005-1 (the assembly's tokens, like the folder name)
    "totalCell": "H1",                // "Total Part No.'s" - left alone if it holds a formula
    "dataSheet": "DXF list"           // second sheet with the full CSV table (all columns); "" = none
  },

  "debug": {
    "saveBodyJson": true,             // copy of the plate geometry in <outputFolder>\_debug
    "writeLog": true                  // <outputFolder>\_logs\LaserDxf_<date>.log
  }
}
