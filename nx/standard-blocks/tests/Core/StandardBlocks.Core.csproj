<Project Sdk="Microsoft.NET.Sdk">
  <!-- The journal's pure-logic half (SB_TEST leaves the NX half out), with
       C# 5 syntax enforced so it stays compatible with NX's journal compiler. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);SB_TEST</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../StandardBlocks.cs" />
  </ItemGroup>
</Project>
