<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the full journal (NX half included) against NxOpenStubs.cs,
       with C# 5 syntax enforced. Building is the test; nothing runs. The
       SB_*.cs files are identical copies, checked by the unit tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NxOpenStubs.cs" />
    <Compile Include="../../StandardBlocks.cs" />
  </ItemGroup>
</Project>
